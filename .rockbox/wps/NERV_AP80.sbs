# NERV AP80 Pro Max by EppsNL (adapted)
# Original NERV by EppsNL - see cfg file for credits, licenses and what not
# Adapted from the 480x360 landscape Innioasis Y1 theme to a
# 360x640 portrait Hidizs AP80 Pro Max layout.
# v2: smaller fonts, wider menu viewport.
#
# SBS File
# Status Bar Off
%wd

# Title Bar Off
%?Lt<|>

# Preload Fonts
%Fl(2,15-KodeMonoMPlus2-SemiBold.fnt)
%Fl(3,18-KodeMonoMPlus2-SemiBold.fnt)
%Fl(4,22-KodeMonoMPlus2-SemiBold.fnt)
%Fl(5,29-KodeMonoMPlus2-SemiBold.fnt)
%Fl(6,35-KodeMonoMPlus2-SemiBold.fnt)

# Preload Images
%xl(T,stop_icon.bmp,0,0)
%xl(L,play_icon.bmp,0,0)
%xl(Z,pause_icon.bmp,0,0)
%xl(F,forward_icon.bmp,0,0)
%xl(R,rewind_icon.bmp,0,0)
%xl(U,usb_noise.bmp,0,0,3)
%xl(NERVLOGO,nervlogo.bmp,0,0)

# USB screen
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usb)|%VI(menuViewport)%Vd(info)>

# Clear Screen
%Vi(clearScreen,0,0,1,1,-)

# NERV logo
%Vl(info,16,18,42,42,-)
%xd(NERVLOGO)

# Menu title
%V(72,22,150,30,3)
%al%s%?Lt<%Lt|NERV>

# NERV label
%Vl(info,226,18,118,18,2)
%acAP80 Pro Max

# Battery percentage
%Vl(info,226,40,118,18,2)
%ac%?bp<EXT PWR|Bat: %bl%%>%Vs(invert)

#__Line
%Vl(info,16,70,328,1,-)
%dr(0,0,328,1,FF3CDC)

#__UI Viewport
%Vi(menuViewport,16,80,328,468,4)

#__Line
%Vl(info,16,556,328,1,-)
%dr(0,0,328,1,FF3CDC)

#__Now Playing
%Vl(info,40,576,31,16,-)
%?mp<%xd(T)|%xd(L)|%xd(Z)|%xd(F)|%xd(R)>
%Vl(info,80,570,268,26,3)
%al %?it<%ia - %it|STOPPED>%Vs(invert)

#__USB
%Vl(usb,0,0,360,640,6)
%?bp<%t(0.1)%xd(Ua);%t(0.1)%xd(Ub);%t(0.1)%xd(Uc)>
